{
    "name": "example/shop",
    "type": "project",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/breeze": "^2.0",
        "spatie/laravel-medialibrary": "^11.0",
        "stripe/stripe-php": "^14.0"
    },
    "require-dev": {
        "nunomaduro/pest": "^3.0",
        "laravel/pint": "^1.13",
        "phpstan/phpstan": "^1.11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
